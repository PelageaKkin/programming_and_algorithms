#include <iostream>
#include <cstdlib> // Для rand() и srand()
#include <ctime>   // Для time()

int main() {
    const int SIZE = 15;
    int arr[SIZE];

    std::srand(std::time(nullptr));

    std::cout << "Array: ";
    for (int i = 0; i < SIZE; i++) {
        arr[i] = std::rand() % 101; // От 0 до 100
        std::cout << arr[i] << " ";
    }
    std::cout << "\n";

    // 1. Ищем максимальный элемент
    int maxVal = arr[0]; // Начинаем с первого элемента
    for (int i = 1; i < SIZE; i++) {
        if (arr[i] > maxVal) {
            maxVal = arr[i];
        }
    }

    // 2. Считаем, сколько раз он встречается
    int countMax = 0;
    for (int i = 0; i < SIZE; i++) {
        if (arr[i] == maxVal) {
            countMax++;
        }
    }

    std::cout << "Maximum element: " << maxVal << "\n";
    std::cout << "He is dating someone " << countMax << " time(s).\n";

    return 0;
}
