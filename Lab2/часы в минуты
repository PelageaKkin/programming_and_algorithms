#include <iostream> //Подключаем библиотеку.

int main() 
{
    double house; //Вводим переменную часы.
    
    std::cout << ":"; //Просим ввести нужное количество часов.

    std::cin >> house; //Считываем введеные цифры в переменную.

    double minutes = house * 60;  //Находим минуты.

    std::cout << house << "ч =" << minutes << "min\n"; //Выводим на экран.

    return 0; //Завершилось успешно.
} //Закрываем функцию main.
