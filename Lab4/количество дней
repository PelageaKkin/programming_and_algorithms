#include <iostream>

int main()
{
    int month;
    std::cout << "Enter a month from 1 to 12:";
    std::cin >> month;
    switch (month) {
    case 1: //месяцы с 31 днем
    case 3:
    case 5:
    case 7:
    case 8:
    case 10:
    case 12:
        std::cout << "31 days\n";
        break;
    case 4: //месяцы с 30
    case 6: 
    case 9:
    case 11:
        std::cout << "30 days\n";
        break;
    case 2: //февраль
        std::cout << "28 days\n";
        break;
    default: //для обработки ошибок
        std::cout << "There is no such month.\n";
        break;
    }
    return 0; 
}
