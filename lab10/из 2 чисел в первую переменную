#include <iostream>

// Функция принимает 'a' по ссылке и 'b' по значению
void setMin(int& a, int b) {
    if (b < a) {
        a = b;
    }
}

int main() {
    int num1, num2;

    // Ввод чисел
    std::cout << "Enter first number: ";
    std::cin >> num1;
    std::cout << "Enter second number: ";
    std::cin >> num2;

    std::cout << "Before: num1 = " << num1 << ", num2 = " << num2 << "\n";

    setMin(num1, num2);

    // Вывод результата
    std::cout << "After:  num1 = " << num1 << ", num2 = " << num2 << "\n";

    return 0;
}
