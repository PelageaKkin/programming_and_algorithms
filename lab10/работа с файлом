#include <iostream>
#include <fstream>
#include <string>

// Функция читает числа из файла, выделяет память и передает размер
void readFromFile(const std::string & filename, int*& arr, int& size) {
    std::ifstream file(filename);

    if (!file.is_open()) {
        std::cout << "Error: could not open file " << filename << "\n";
        arr = nullptr;
        size = 0;
        return;
    }

    // Считаем количество чисел в файле
    int temp;
    size = 0;
    while (file >> temp) {
        size++;
    }

    // Выделяем память под массив
    arr = new int[size];

    // Возвращаемся в начало файла и читаем числа
    file.clear();
    file.seekg(0, std::ios::beg);

    for (int i = 0; i < size; i++) {
        file >> arr[i];
    }

    file.close();
}

int main() {
    int* myArray = nullptr; // Указатель для массива
    int mySize = 0;         // Переменная для размера

    // Читаем из файла numbers.txt
    readFromFile("numbers.txt", myArray, mySize);

    if (myArray != nullptr) {
        std::cout << "Read " << mySize << " numbers: ";
        for (int i = 0; i < mySize; i++) {
            std::cout << myArray[i] << " ";
        }
        std::cout << "\n";

        // Очищаем память
        delete[] myArray;
    }
    else {
        std::cout << "Array is empty.\n";
    }

    return 0;
}
